---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { GUIDE } from '../../../netlify/guide-data.mjs';

// Guest guide served at cottage.lakedistrictescapes.uk. It is open (no access
// code) — the private cottage link + `noindex` are the privacy. The full guide
// (property manual, local area and walks) is inlined and rendered on load.
const fullGuide = {
  properties: Object.fromEntries(Object.entries(GUIDE.properties).filter(([, p]) => !p.hidden)),
  area: GUIDE.area,
  outdoors: GUIDE.outdoors,
};
const guideJson = JSON.stringify(fullGuide).replace(/</g, '\\u003c');
---
<Base
  title="Guest Guide — Lake District Escapes"
  description="Your guest guide for Primrose Cottage — how everything works, plus where to eat, explore and the walks, runs and rides on the doorstep."
  noindex={true}
>
  <Nav slot="nav" logoHref="/" ctaHref="/#enquire" ctaLabel="Enquire" />

  <div class="guest-page">
    <section class="guest-hero">
      <p class="eyebrow">Guest Guide</p>
      <h1>Welcome to Your<br /><em>Lake District Escape</em></h1>
      <p>
        Everything for your stay in one place — how the cottage works, plus where to eat, explore and
        the walks, runs and rides right on the doorstep.
      </p>
    </section>

    <div class="guest-wrap">
      <div class="guide show" id="guide">
        <div class="guide-tabs" id="guide-tabs" role="tablist"></div>
        <div id="guide-content"></div>
      </div>
      <script type="application/json" id="full-guide" is:inline set:html={guideJson}></script>
    </div>
  </div>

  <Footer
    slot="footer"
    links={[
      { href: '/', label: 'Home' },
      { href: '/the-rockery/', label: 'The Rockery' },
      { href: '/primrose-cottage/', label: 'Primrose Cottage' },
      { href: '/#enquire', label: 'Enquire' },
    ]}
  />
</Base>

<script>
  import { renderArea, renderProperty } from '../../scripts/guide-ui.js';

  const tabsEl = document.getElementById('guide-tabs');
  const contentEl = document.getElementById('guide-content');

  let GUIDE = {};
  try {
    GUIDE = JSON.parse(document.getElementById('full-guide').textContent || '{}');
  } catch (e) {
    GUIDE = {};
  }

  const panels = [];
  Object.entries(GUIDE.properties || {}).forEach(([key, prop]) => {
    panels.push({ id: key, label: prop.name, render: () => renderProperty(prop) });
  });
  if (GUIDE.area) {
    panels.push({ id: 'area', label: GUIDE.area.title || 'The Area', render: () => renderArea(GUIDE.area) });
  }
  if (GUIDE.outdoors) {
    panels.push({ id: 'outdoors', label: GUIDE.outdoors.title || 'Walks & Rides', render: () => renderArea(GUIDE.outdoors) });
  }

  const panelEls = {};
  panels.forEach((p, i) => {
    const tab = document.createElement('button');
    tab.className = 'guide-tab' + (i === 0 ? ' active' : '');
    tab.textContent = p.label;
    tab.setAttribute('role', 'tab');
    tab.dataset.target = p.id;
    tabsEl.appendChild(tab);

    const panel = document.createElement('div');
    panel.className = 'guide-panel' + (i === 0 ? ' active' : '');
    panel.id = 'panel-' + p.id;
    panel.appendChild(p.render());
    contentEl.appendChild(panel);
    panelEls[p.id] = { tab, panel };
  });

  tabsEl.addEventListener('click', (ev) => {
    const btn = ev.target.closest('.guide-tab');
    if (!btn) return;
    Object.values(panelEls).forEach(({ tab, panel }) => {
      const on = tab === btn;
      tab.classList.toggle('active', on);
      panel.classList.toggle('active', on);
    });
  });
</script>
