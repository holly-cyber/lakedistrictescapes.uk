---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { GUIDE } from '../../../netlify/guide-data.mjs';

// Public local guide (no access code). Shows the area + walks content only;
// the private property manual lives on the (unlisted) cottage guide.
const publicGuide = {
  area: GUIDE.area,
  outdoors: GUIDE.outdoors,
};
const publicJson = JSON.stringify(publicGuide).replace(/</g, '\\u003c');
---
<Base
  title="Local Area Guide — Lake District Escapes"
  description="Explore Shap and the Lake District — where to eat, drink and shop, plus the walks, runs and rides right on the doorstep."
>
  <Nav slot="nav" logoHref="/" ctaHref="/#enquire" ctaLabel="Enquire" />

  <div class="guest-page">
    <section class="guest-hero">
      <p class="eyebrow">Local Area Guide</p>
      <h1>Shap &amp; the<br /><em>Lake District</em></h1>
      <p>
        Where to eat, drink and explore around Shap, plus the walks, runs and rides right on the
        doorstep — everything you need to make the most of the Eastern Lakes.
      </p>
    </section>

    <div class="guest-wrap">
      <div class="guide show" id="guide">
        <div class="guide-tabs" id="guide-tabs" role="tablist"></div>
        <div id="guide-content"></div>
      </div>
      <script type="application/json" id="public-guide" is:inline set:html={publicJson}></script>
    </div>
  </div>

  <Footer
    slot="footer"
    links={[
      { href: '/', label: 'Home' },
      { href: '/the-rockery/', label: 'The Rockery' },
      { href: '/primrose-cottage/', label: 'Primrose Cottage' },
      { href: '/#enquire', label: 'Enquire' },
    ]}
  />
</Base>

<script>
  import { renderArea } from '../../scripts/guide-ui.js';

  const tabsEl = document.getElementById('guide-tabs');
  const contentEl = document.getElementById('guide-content');

  let GUIDE = {};
  try {
    GUIDE = JSON.parse(document.getElementById('public-guide').textContent || '{}');
  } catch (e) {
    GUIDE = {};
  }

  const panels = [];
  if (GUIDE.area) {
    panels.push({ id: 'area', label: GUIDE.area.title || 'The Area', render: () => renderArea(GUIDE.area) });
  }
  if (GUIDE.outdoors) {
    panels.push({ id: 'outdoors', label: GUIDE.outdoors.title || 'Walks & Rides', render: () => renderArea(GUIDE.outdoors) });
  }

  const panelEls = {};
  panels.forEach((p, i) => {
    const tab = document.createElement('button');
    tab.className = 'guide-tab' + (i === 0 ? ' active' : '');
    tab.textContent = p.label;
    tab.setAttribute('role', 'tab');
    tab.dataset.target = p.id;
    tabsEl.appendChild(tab);

    const panel = document.createElement('div');
    panel.className = 'guide-panel' + (i === 0 ? ' active' : '');
    panel.id = 'panel-' + p.id;
    panel.appendChild(p.render());
    contentEl.appendChild(panel);
    panelEls[p.id] = { tab, panel };
  });

  tabsEl.addEventListener('click', (ev) => {
    const btn = ev.target.closest('.guide-tab');
    if (!btn) return;
    Object.values(panelEls).forEach(({ tab, panel }) => {
      const on = tab === btn;
      tab.classList.toggle('active', on);
      panel.classList.toggle('active', on);
    });
  });
</script>
