---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/the-rockery/', label: 'The Rockery' },
  { href: '/primrose-cottage/', label: 'Primrose Cottage' },
];
---
<Base
  title="Guest Book — Lake District Escapes"
  description="Read what our guests say about The Rockery and Primrose Cottage — and leave a note of your own in the Lake District Escapes guest book."
>
  <Nav slot="nav" links={links} logoHref="/" ctaHref="/#enquire" ctaLabel="Enquire" />

  <div class="guest-page">
    <section class="guest-hero">
      <p class="eyebrow">Guest Book</p>
      <h1>Kind Words from<br /><em>Our Guests</em></h1>
      <p>
        Stayed with us at The Rockery or Primrose Cottage? We'd love to hear about it. Read others'
        stories below, then leave a note of your own.
      </p>
    </section>

    <div class="guest-wrap">
      <!-- SIGN THE BOOK -->
      <div class="guest-form-card">
        <h2>Sign the Guest Book</h2>
        <form class="guest-form" id="guest-form" novalidate>
          <!-- Honeypot -->
          <div class="hp-field" aria-hidden="true">
            <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="g-name">Your Name *</label>
              <input id="g-name" name="name" type="text" maxlength="60" placeholder="e.g. The Wilson Family" required />
            </div>
            <div class="form-field">
              <label for="g-location">Where From</label>
              <input id="g-location" name="location" type="text" maxlength="80" placeholder="e.g. Yorkshire" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="g-stay">Which Stay</label>
              <select id="g-stay" name="stay">
                <option value="The Rockery">The Rockery</option>
                <option value="Primrose Cottage">Primrose Cottage</option>
                <option value="Both properties">Both properties</option>
              </select>
            </div>
            <div class="form-field">
              <label>Your Rating</label>
              <div class="guest-rating" id="g-rating" role="radiogroup" aria-label="Star rating">
                <!-- rendered as stars; hidden radios hold the value -->
                <input type="radio" name="rating" id="star5" value="5" checked />
                <label for="star5" title="5 stars" aria-label="5 stars">★</label>
                <input type="radio" name="rating" id="star4" value="4" />
                <label for="star4" title="4 stars" aria-label="4 stars">★</label>
                <input type="radio" name="rating" id="star3" value="3" />
                <label for="star3" title="3 stars" aria-label="3 stars">★</label>
                <input type="radio" name="rating" id="star2" value="2" />
                <label for="star2" title="2 stars" aria-label="2 stars">★</label>
                <input type="radio" name="rating" id="star1" value="1" />
                <label for="star1" title="1 star" aria-label="1 star">★</label>
              </div>
            </div>
          </div>

          <div class="form-field">
            <label for="g-message">Your Message *</label>
            <textarea id="g-message" name="message" maxlength="800" placeholder="Tell us about your stay…" required></textarea>
          </div>

          <button type="submit" class="guest-btn" id="g-submit">Sign the Guest Book</button>
          <p class="guest-status" id="g-status" role="status" aria-live="polite"></p>
        </form>
      </div>

      <!-- ENTRIES -->
      <div class="guest-entries-head">
        <h2>Recent Signings</h2>
        <span class="guest-count" id="g-count"></span>
      </div>
      <div class="guest-entries" id="g-entries">
        <p class="guest-loading">Loading the guest book…</p>
      </div>
    </div>
  </div>

  <Footer
    slot="footer"
    links={[
      { href: '/', label: 'Home' },
      { href: '/the-rockery/', label: 'The Rockery' },
      { href: '/primrose-cottage/', label: 'Primrose Cottage' },
      { href: '/guest/', label: 'Guest Book' },
      { href: '/#enquire', label: 'Enquire' },
    ]}
  />
</Base>

<script>
  const API = '/api/guestbook';
  const entriesEl = document.getElementById('g-entries');
  const countEl = document.getElementById('g-count');
  const form = document.getElementById('guest-form');
  const statusEl = document.getElementById('g-status');
  const submitBtn = document.getElementById('g-submit');

  const STARS = (n) => '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n);

  function formatDate(ts) {
    if (!ts) return '';
    try {
      return new Date(ts).toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      });
    } catch {
      return '';
    }
  }

  // Build each entry with textContent only — never innerHTML — so any user
  // text is safely escaped by the DOM.
  function renderEntry(e) {
    const card = document.createElement('article');
    card.className = 'guest-entry';

    const top = document.createElement('div');
    top.className = 'guest-entry-top';

    const name = document.createElement('span');
    name.className = 'guest-entry-name';
    name.textContent = e.name || 'A guest';
    top.appendChild(name);

    if (e.stay) {
      const stay = document.createElement('span');
      stay.className = 'guest-entry-stay';
      stay.textContent = e.stay;
      top.appendChild(stay);
    }
    card.appendChild(top);

    if (e.rating) {
      const stars = document.createElement('div');
      stars.className = 'guest-entry-stars';
      stars.textContent = STARS(e.rating);
      stars.setAttribute('aria-label', e.rating + ' out of 5');
      card.appendChild(stars);
    }

    const msg = document.createElement('p');
    msg.className = 'guest-entry-msg';
    msg.textContent = e.message || '';
    card.appendChild(msg);

    const meta = document.createElement('div');
    meta.className = 'guest-entry-date';
    const bits = [];
    if (e.location) bits.push(e.location);
    const d = formatDate(e.createdAt);
    if (d) bits.push(d);
    meta.textContent = bits.join(' · ');
    card.appendChild(meta);

    return card;
  }

  async function loadEntries() {
    try {
      const res = await fetch(API, { headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error('bad status');
      const data = await res.json();
      const entries = Array.isArray(data.entries) ? data.entries : [];
      entriesEl.textContent = '';
      if (entries.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'guest-empty';
        empty.textContent = 'Be the first to sign our guest book.';
        entriesEl.appendChild(empty);
        countEl.textContent = '';
        return;
      }
      entries.forEach((e) => entriesEl.appendChild(renderEntry(e)));
      countEl.textContent =
        entries.length + (entries.length === 1 ? ' signing' : ' signings');
    } catch (err) {
      entriesEl.textContent = '';
      const p = document.createElement('p');
      p.className = 'guest-empty';
      p.textContent = 'The guest book is unavailable right now — please try again later.';
      entriesEl.appendChild(p);
    }
  }

  function showStatus(msg, ok) {
    statusEl.textContent = msg;
    statusEl.className = 'guest-status show ' + (ok ? 'ok' : 'err');
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const fd = new FormData(form);
    const payload = {
      name: (fd.get('name') || '').toString(),
      location: (fd.get('location') || '').toString(),
      stay: (fd.get('stay') || '').toString(),
      rating: (fd.get('rating') || '5').toString(),
      message: (fd.get('message') || '').toString(),
      website: (fd.get('website') || '').toString(), // honeypot
    };

    if (payload.name.trim().length < 2) return showStatus('Please tell us your name.', false);
    if (payload.message.trim().length < 4) return showStatus('Please leave a short message.', false);

    submitBtn.disabled = true;
    submitBtn.textContent = 'Signing…';
    try {
      const res = await fetch(API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Something went wrong.');
      showStatus('Thank you — your message has been added to the guest book!', true);
      form.reset();
      await loadEntries();
    } catch (err) {
      showStatus(err.message || 'Sorry, we could not save your message.', false);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign the Guest Book';
    }
  });

  loadEntries();
</script>
