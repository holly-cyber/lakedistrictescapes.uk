---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/the-rockery/', label: 'The Rockery' },
  { href: '/primrose-cottage/', label: 'Primrose Cottage' },
];
---
<Base
  title="Guest Guide — Lake District Escapes"
  description="The guest welcome guide for The Rockery and Primrose Cottage — local area tips and how everything works. Access with the code from your booking."
>
  <Nav slot="nav" links={links} logoHref="/" ctaHref="/#enquire" ctaLabel="Enquire" />

  <div class="guest-page">
    <section class="guest-hero">
      <p class="eyebrow">Guest Guide</p>
      <h1>Welcome to Your<br /><em>Lake District Escape</em></h1>
      <p>
        Everything you need for a brilliant stay — where to eat, shop and explore around Shap, and how
        everything works in the house. Enter the access code from your booking to open your guide.
      </p>
    </section>

    <div class="guest-wrap">
      <!-- GATE -->
      <div class="guest-form-card gate-card" id="gate">
        <div class="gate-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="4" y="10" width="16" height="10" rx="2" />
            <path d="M8 10V7a4 4 0 018 0v3" />
          </svg>
        </div>
        <h2>Enter Your Access Code</h2>
        <form class="guest-form" id="gate-form" novalidate>
          <div class="form-field">
            <label for="g-code">Access Code</label>
            <input id="g-code" name="code" type="text" autocomplete="off" autocapitalize="none"
              spellcheck="false" placeholder="From your booking email" required />
          </div>
          <button type="submit" class="guest-btn" id="g-unlock">Open My Guide</button>
          <p class="guest-status" id="g-status" role="status" aria-live="polite"></p>
        </form>
        <p class="gate-hint">
          The code is in your booking confirmation. Can't find it? Email
          <strong>hello@lakedistrictescapes.uk</strong> and we'll send it over.
        </p>
      </div>

      <!-- GUIDE (revealed after unlock) -->
      <div class="guide" id="guide">
        <div class="guide-tabs" id="guide-tabs" role="tablist"></div>
        <div id="guide-content">
          <p class="guide-loading">Loading your guide…</p>
        </div>
      </div>
    </div>
  </div>

  <Footer
    slot="footer"
    links={[
      { href: '/', label: 'Home' },
      { href: '/the-rockery/', label: 'The Rockery' },
      { href: '/primrose-cottage/', label: 'Primrose Cottage' },
      { href: '/guest/', label: 'Guest Guide' },
      { href: '/#enquire', label: 'Enquire' },
    ]}
  />
</Base>

<script>
  const API = '/api/guest-guide';
  const STORAGE_KEY = 'lde-guest-code';

  const gate = document.getElementById('gate');
  const gateForm = document.getElementById('gate-form');
  const codeInput = document.getElementById('g-code');
  const unlockBtn = document.getElementById('g-unlock');
  const statusEl = document.getElementById('g-status');
  const guideEl = document.getElementById('guide');
  const tabsEl = document.getElementById('guide-tabs');
  const contentEl = document.getElementById('guide-content');

  function showStatus(msg, ok) {
    statusEl.textContent = msg;
    statusEl.className = 'guest-status show ' + (ok ? 'ok' : 'err');
  }

  // Append text, wrapping [[ placeholders ]] in a highlighted span so unfilled
  // details are obvious to the owner. Uses text nodes only — never innerHTML.
  function appendText(el, text) {
    const re = /\[\[(.+?)\]\]/g;
    let last = 0,
      m;
    while ((m = re.exec(text))) {
      if (m.index > last) el.appendChild(document.createTextNode(text.slice(last, m.index)));
      const span = document.createElement('span');
      span.className = 'ph';
      span.textContent = m[1].trim();
      el.appendChild(span);
      last = re.lastIndex;
    }
    if (last < text.length) el.appendChild(document.createTextNode(text.slice(last)));
  }

  function el(tag, className, text) {
    const n = document.createElement(tag);
    if (className) n.className = className;
    if (text != null) appendText(n, text);
    return n;
  }

  function renderArea(area) {
    const wrap = document.createDocumentFragment();
    if (area.intro) wrap.appendChild(el('p', 'guide-intro', area.intro));
    (area.groups || []).forEach((group) => {
      const g = el('div', 'area-group');
      g.appendChild(el('h3', 'area-group-name', group.name));
      (group.items || []).forEach((item) => {
        const it = el('div', 'area-item');
        it.appendChild(el('div', 'area-item-name', item.name));
        if (item.note) it.appendChild(el('div', 'area-item-note', item.note));
        g.appendChild(it);
      });
      wrap.appendChild(g);
    });
    return wrap;
  }

  function renderProperty(prop) {
    const wrap = document.createDocumentFragment();
    if (prop.tagline) wrap.appendChild(el('div', 'guide-property-tagline', prop.tagline));
    (prop.sections || []).forEach((sec) => {
      const s = el('div', 'manual-section');
      s.appendChild(el('h3', null, sec.title));
      if (sec.body) s.appendChild(el('p', null, sec.body));
      if (Array.isArray(sec.items) && sec.items.length) {
        const ul = el('ul', 'manual-list');
        sec.items.forEach((li) => ul.appendChild(el('li', null, li)));
        s.appendChild(ul);
      }
      if (Array.isArray(sec.fields) && sec.fields.length) {
        const fw = el('div', 'manual-fields');
        sec.fields.forEach((f) => {
          const row = el('div', 'manual-field');
          row.appendChild(el('span', 'manual-field-label', f.label));
          row.appendChild(el('span', 'manual-field-value', f.value));
          fw.appendChild(row);
        });
        s.appendChild(fw);
      }
      wrap.appendChild(s);
    });
    return wrap;
  }

  function buildGuide(guide) {
    // Assemble tab definitions: Area first, then each property.
    const panels = [];
    panels.push({ id: 'area', label: guide.area.title || 'The Area', render: () => renderArea(guide.area) });
    Object.entries(guide.properties || {}).forEach(([key, prop]) => {
      panels.push({ id: key, label: prop.name, render: () => renderProperty(prop) });
    });

    tabsEl.textContent = '';
    contentEl.textContent = '';

    const panelEls = {};
    panels.forEach((p, i) => {
      const tab = document.createElement('button');
      tab.className = 'guide-tab' + (i === 0 ? ' active' : '');
      tab.textContent = p.label;
      tab.setAttribute('role', 'tab');
      tab.dataset.target = p.id;
      tabsEl.appendChild(tab);

      const panel = document.createElement('div');
      panel.className = 'guide-panel' + (i === 0 ? ' active' : '');
      panel.id = 'panel-' + p.id;
      panel.appendChild(p.render());
      contentEl.appendChild(panel);
      panelEls[p.id] = { tab, panel };
    });

    tabsEl.addEventListener('click', (e) => {
      const btn = e.target.closest('.guide-tab');
      if (!btn) return;
      Object.values(panelEls).forEach(({ tab, panel }) => {
        const on = tab === btn;
        tab.classList.toggle('active', on);
        panel.classList.toggle('active', on);
      });
      window.scrollTo({ top: guideEl.offsetTop - 80, behavior: 'smooth' });
    });
  }

  async function unlock(code, { fromStorage } = {}) {
    unlockBtn.disabled = true;
    unlockBtn.textContent = 'Opening…';
    try {
      const res = await fetch(API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Something went wrong.');
      sessionStorage.setItem(STORAGE_KEY, code);
      gate.style.display = 'none';
      guideEl.classList.add('show');
      buildGuide(data.guide);
    } catch (err) {
      if (fromStorage) {
        // stale/invalid stored code — just show the gate again
        sessionStorage.removeItem(STORAGE_KEY);
      } else {
        showStatus(err.message || 'Sorry, we could not open the guide.', false);
      }
    } finally {
      unlockBtn.disabled = false;
      unlockBtn.textContent = 'Open My Guide';
    }
  }

  gateForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const code = codeInput.value.trim();
    if (!code) return showStatus('Please enter your access code.', false);
    unlock(code);
  });

  // Re-open automatically if a valid code was used earlier this session.
  const saved = sessionStorage.getItem(STORAGE_KEY);
  if (saved) unlock(saved, { fromStorage: true });
</script>
