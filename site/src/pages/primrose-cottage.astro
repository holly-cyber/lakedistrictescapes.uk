---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const links = [
  { href: '#about', label: 'About' },
  { href: '#inside', label: "What's Inside" },
  { href: '#location', label: 'Location' },
  { href: '#coast-to-coast', label: 'Walkers & Cyclists' },
  { href: '/', label: 'All Properties' },
];

// Getting-around distances from Shap (drive times).
const distances = [
  { time: '15 min', place: 'Fells & open moorland' },
  { time: 'On it', place: 'M6 Junction 39' },
  { time: '15 min', place: 'Penrith (A6 north)' },
  { time: '20 min', place: 'Kendal (A6 south)' },
  { time: '15 min', place: 'Haweswater & Mardale' },
  { time: '25 min', place: 'Ullswater & Pooley Bridge' },
  { time: '40 min', place: 'Keswick & Derwentwater' },
  { time: '45–50 min', place: 'Windermere & Ambleside' },
];
---
<Base
  title="Primrose Cottage — Self-Catering One-Bedroom Retreat in Shap | Lake District Escapes"
  description="Primrose Cottage is a peaceful, self-contained one-bedroom retreat in Shap, Cumbria — king bed, private entrance, welcome pack and an ideal Coast to Coast stopover. Sleeps 2 adults plus 1 child under 2."
  ogImage="/images/primrose-main.jpg"
>
  <Nav slot="nav" links={links} logoHref="/" ctaHref="#enquire" ctaLabel="Book Now" />

  <!-- HERO -->
  <section class="hero page-hero">
    <div class="hero-left hero-scene" style="background:var(--gable-deep);">
      <!-- Decorative layered fell silhouette (replaces the plain circles) -->
      <svg class="hero-scene-art" viewBox="0 0 480 260" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <circle cx="408" cy="96" r="26" fill="var(--kendal-mint)" opacity="0.55" />
        <path d="M0 260 V142 C60 108 118 122 175 102 C232 82 262 128 322 114 C388 99 432 130 480 118 V260 Z"
          fill="var(--scafell-sky)" opacity="0.34" />
        <path d="M0 260 V182 C70 152 130 168 200 152 C270 136 322 178 390 162 C438 151 470 170 480 165 V260 Z"
          fill="var(--kendal-mint)" opacity="0.28" />
        <path d="M0 260 V216 C90 191 170 208 250 198 C330 188 402 212 480 206 V260 Z"
          fill="#2f3326" opacity="0.45" />
      </svg>
      <div class="hero-scene-inner">
        <div class="hero-pill">Self-Contained One-Bedroom Retreat · Shap</div>
        <h1 class="hero-h1">Primrose<br /><em>Cottage</em></h1>
        <p class="hero-sub">
          A peaceful, self-contained one-bedroom retreat in the Cumbrian village of Shap. Warm,
          comfortable and thoughtfully put together — a proper home-from-home.
        </p>
        <div class="hero-actions">
          <a href="#enquire" class="btn btn-white" style="color:var(--gable-deep);">Check Availability</a>
          <a href="#about" class="btn btn-outline">Explore</a>
        </div>
        <div class="hero-stats">
          <div><div class="h-stat-num">1</div><div class="h-stat-label">Bedroom</div></div>
          <div><div class="h-stat-num">2</div><div class="h-stat-label">Adults</div></div>
          <div><div class="h-stat-num">+1</div><div class="h-stat-label">Child Under 2</div></div>
        </div>
      </div>
    </div>
    <div class="hero-right">
      <img src="/images/primrose-main.jpg" alt="Primrose Cottage, Shap" />
      <div class="hero-overlay-card">
        <div class="hoc-label" style="color:var(--gable-deep);">Home-from-home</div>
        <div class="hoc-val">Primrose Cottage</div>
        <div class="hoc-sub">Shap Village, Cumbria · Private entrance &amp; key</div>
      </div>
    </div>
  </section>

  <!-- BADGES -->
  <div class="badges badges--contrast">
    <div class="badge-item"><span class="badge-dot"></span>All Bills Included</div>
    <div class="badge-item"><span class="badge-dot"></span>Private Entrance &amp; Key</div>
    <div class="badge-item"><span class="badge-dot"></span>King-Size Bed</div>
    <div class="badge-item"><span class="badge-dot"></span>Welcome Pack on Arrival</div>
    <div class="badge-item"><span class="badge-dot"></span>Wi-Fi &amp; Digital TV</div>
    <div class="badge-item"><span class="badge-dot"></span>Central Heating &amp; Electric Fire</div>
    <div class="badge-item"><span class="badge-dot"></span>Seating Area &amp; BBQ</div>
    <div class="badge-item"><span class="badge-dot"></span>Bike Storage by Arrangement</div>
  </div>

  <!-- ABOUT -->
  <section class="section about" id="about">
    <div class="about-inner">
      <div class="reveal">
        <p class="eyebrow">The Cottage</p>
        <h2 class="section-h">A Proper<br /><em>Home-from-Home</em></h2>
        <div class="about-text">
          <p>
            Primrose Cottage is a peaceful, self-contained one-bedroom retreat in the Cumbrian village
            of Shap — warm, comfortable and thoughtfully put together. Step outside and you're spoilt
            for choice: Shap sits on the eastern edge of the Lake District, with open moorland, high
            fells and quiet valleys on the doorstep.
          </p>
          <p>
            Whether you're here to walk, cycle, swim in a tarn, or simply slow down and breathe, you
            won't have to go far to find it. A perfect base for exploring Shap, the Eden Valley and the
            wider Lake District.
          </p>
        </div>
        <div class="about-highlight">
          <p>
            Your hosts are keen runners, cyclists and swimmers — so we've thought hard about the details
            that actually matter after a long day out.
          </p>
        </div>
        <a href="#enquire" class="btn btn-green" style="margin-top:2rem;">Enquire About the Cottage</a>
      </div>
      <div class="about-images reveal" style="transition-delay:0.15s;">
        <div class="ai-card span2" style="height:220px;">
          <img src="/images/primrose-int-2.jpg" alt="Primrose Cottage sitting room" loading="lazy" />
        </div>
        <div class="ai-card" style="height:180px;">
          <img src="/images/primrose-int-1.jpg" alt="Primrose Cottage interior" loading="lazy" />
        </div>
        <div class="ai-card" style="height:180px;">
          <img src="/images/primrose-int-3.jpg" alt="Primrose Cottage bedroom" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S INSIDE (room by room) -->
  <section class="section rooms" id="inside">
    <div class="rooms-intro">
      <div class="reveal">
        <p class="eyebrow">What's Inside</p>
        <h2 class="section-h">Thoughtful in<br /><em>Every Detail</em></h2>
      </div>
      <div class="reveal" style="transition-delay:.1s;">
        <p>
          Entirely self-contained, with everything sorted so you can settle straight in. On arrival
          you'll find the kitchen loaded with milk, tea, coffee and cereal to see you through the first
          morning — just let us know any dietary requirements or a milk preference when you book and
          we'll have it ready before you get here.
        </p>
      </div>
    </div>
    <div class="rooms-grid reveal">
      <div class="room-card">
        <div class="room-num">Private &amp; Self-Contained</div>
        <div class="room-name">Entrance &amp; Kitchen</div>
        <p class="room-desc">
          Your own private entrance and key. The kitchen has a fridge, kettle, toaster, microwave and
          induction hob &amp; oven, plus everything you need to cook a proper meal — pots and pans,
          baking trays, sharp knives, chopping board, crockery, glassware, mugs, seasoning and basic
          cleaning supplies. A shoe rack and hooks by the door for wet coats and boots.
        </p>
      </div>
      <div class="room-card">
        <div class="room-num">Warm in Minutes</div>
        <div class="room-name">Sitting Room</div>
        <p class="room-desc">
          Central heating throughout plus an electric fire, so you can come in off the fells wet and
          cold and be warm within minutes. A comfortable sofa, digital TV, Wi-Fi and a dining table
          for two.
        </p>
      </div>
      <div class="room-card">
        <div class="room-num">Rest &amp; Recover</div>
        <div class="room-name">Bedroom</div>
        <p class="room-desc">
          A king-size bed with wardrobe space and hangers, an iron and ironing board, and a drying rack
          for damp walking gear.
        </p>
      </div>
      <div class="room-card">
        <div class="room-num">Everything Provided</div>
        <div class="room-name">Shower Room</div>
        <p class="room-desc">
          Shower room with toilet and basin. Hand soap, shower gel, shampoo and conditioner all
          provided, along with hand and bath towels.
        </p>
      </div>
      <div class="room-card">
        <div class="room-num">Cumbrian Evenings</div>
        <div class="room-name">Outside</div>
        <p class="room-desc">
          Your own seating area for lazy breakfasts, and a BBQ for the atmospheric Cumbria evenings.
        </p>
      </div>
      <div class="room-card">
        <div class="room-num">Good to Know</div>
        <div class="room-name">Sleeps 2 + 1</div>
        <p class="room-desc">
          Primrose Cottage sleeps 2 adults plus 1 child under 2. Secure bicycle storage is available by
          prior arrangement, subject to space.
        </p>
      </div>
    </div>
  </section>

  <!-- COTTAGE INTERIOR STRIP -->
  <section class="gallery-grid" style="grid-template-columns:repeat(4,1fr);grid-template-rows:280px;gap:0;">
    <div class="g-card"><img src="/images/primrose-int-1.jpg" alt="Primrose Cottage interior" loading="lazy" /></div>
    <div class="g-card"><img src="/images/primrose-int-2.jpg" alt="Primrose Cottage interior" loading="lazy" /></div>
    <div class="g-card"><img src="/images/primrose-int-3.jpg" alt="Primrose Cottage interior" loading="lazy" /></div>
    <div class="g-card"><img src="/images/primrose-int-4.jpg" alt="Primrose Cottage interior" loading="lazy" /></div>
  </section>

  <!-- LOCATION & GETTING AROUND -->
  <section class="section location" id="location">
    <div class="location-inner">
      <div class="reveal">
        <p class="eyebrow">Where to Find Us</p>
        <h2 class="section-h">Shap, and the<br /><em>Whole of Cumbria</em></h2>
        <p>
          The fells start around fifteen minutes away — but what really makes Shap work is the position.
          You're just off the M6 at Junction 39, so the whole of Cumbria opens up without the slow crawl
          through the middle of the National Park.
        </p>
        <p>
          Penrith, your nearest proper town, is fifteen minutes north up the A6 — a working market town
          with a good butcher, a proper deli, independent shops around Angel Lane, the ruined castle by
          the station and Booths for a serious food shop. Kendal is twenty minutes south for the Brewery
          Arts Centre and independent shops; Keswick, about forty minutes north-west, gives you
          Derwentwater, the launches, Catbells and the northern fells. Ullswater, Haweswater, Windermere
          and Ambleside are all an easy drive.
        </p>
      </div>
      <div class="reveal" style="transition-delay:.15s;">
        <div class="loc-stats">
          {distances.map((d) => (
            <div class="loc-stat">
              <div class="ls-num">{d.time}</div>
              <div class="ls-label">{d.place}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- COAST TO COAST / WALKERS & CYCLISTS -->
  <section class="annexe" id="coast-to-coast">
    <div class="annexe-img reveal">
      <img src="/images/fell-views.jpg" alt="Cumbrian fells near Shap" loading="lazy" />
      <div class="annexe-img-badge">Walkers &amp; Cyclists</div>
    </div>
    <div class="annexe-content reveal" style="transition-delay:.15s;">
      <p class="eyebrow">Coast to Coast &amp; Long-Distance Routes</p>
      <h2 class="section-h">An Ideal<br /><em>Stopover</em></h2>
      <p>
        Walking the Coast to Coast or riding one of the long-distance routes? Primrose Cottage makes an
        ideal stopover for a night or two — somewhere to rest and recover, dry your kit, eat properly
        and sleep well before the next leg.
      </p>
      <div class="annexe-list">
        <div class="al-item"><span class="al-dot"></span>Drying rack for damp walking gear &amp; warmth within minutes</div>
        <div class="al-item"><span class="al-dot"></span>Full kitchen to cook a proper meal after a long day</div>
        <div class="al-item"><span class="al-dot"></span>Luggage-transfer services can drop &amp; collect your bags here</div>
        <div class="al-item"><span class="al-dot"></span>Hosts who are keen runners, cyclists &amp; swimmers</div>
        <div class="al-item"><span class="al-dot"></span>Secure bicycle storage by prior arrangement, subject to space</div>
      </div>
      <a href="#enquire" class="btn btn-green" style="margin-top:1.8rem;">Plan Your Stopover</a>
    </div>
  </section>

  <!-- ENQUIRE -->
  <section class="section enquire" style="background:var(--gable-deep);" id="enquire">
    <div class="enquire-inner">
      <div class="reveal">
        <p class="eyebrow" style="color:var(--kendal-mint);">Book Your Stay</p>
        <h2 class="section-h" style="color:#fff;">Ready for a<br /><em style="color:var(--kendal-mint);">Cosy Escape</em>?</h2>
        <p class="enquire-desc">
          Send us your dates and we'll come back to you with full availability and pricing. Tell us any
          dietary requirements or a milk preference and we'll have your welcome pack ready before you
          arrive — and let us know if you'll need luggage transfer or bike storage arranged.
        </p>
        <p class="enquire-desc" style="margin-top:1rem;">
          Or reach us directly at<br /><strong style="color:#fff;">hello@lakedistrictescapes.uk</strong>
        </p>
      </div>
      <div class="enquire-form-wrap reveal" style="transition-delay:.15s;">
        <form name="enquiry-primrose" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/">
          <input type="hidden" name="form-name" value="enquiry-primrose" />
          <input type="hidden" name="property" value="Primrose Cottage" />
          <p class="hp-field"><label>Don't fill this in: <input name="bot-field" /></label></p>
          <div class="form-row">
            <div class="form-field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" placeholder="Your name" required />
            </div>
            <div class="form-field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" placeholder="you@example.com" required />
            </div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label for="arrive">Arrival</label>
              <input id="arrive" name="arrive" type="date" />
            </div>
            <div class="form-field">
              <label for="depart">Departure</label>
              <input id="depart" name="depart" type="date" />
            </div>
          </div>
          <div class="form-field">
            <label for="message">Message · dietary needs, milk preference, luggage transfer</label>
            <textarea id="message" name="message" placeholder="Tell us a little about your trip…"></textarea>
          </div>
          <button class="form-submit" style="color:var(--gable-deep);" type="submit">Send Enquiry</button>
          <p class="form-note">We aim to respond within 4 hours during business hours.</p>
        </form>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
