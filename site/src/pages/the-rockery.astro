---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AvailabilityCalendar from '../components/AvailabilityCalendar.astro';

---
<Base
  title="The Rockery — Grade II Listed Holiday House in Shap | Lake District Escapes"
  description="The Rockery is a Grade II Listed holiday house in Shap, Lake District. Sleeps 9 (up to 11 with Primrose Cottage). Five bedrooms, log burner, enclosed garden, dogs welcome, walks from the door."
  ogImage="/images/rockery-hero.jpg"
>
  <Nav slot="nav" logoHref="/" ctaHref="#enquire" ctaLabel="Book Now" />

  <!-- HERO -->
  <section class="hero page-hero">
    <div class="hero-left">
      <div class="hero-pill">Grade II Listed · Coming Soon 2027</div>
      <h1 class="hero-h1">The<br /><em>Rockery</em></h1>
      <p class="hero-sub">
        A Grade II Listed retreat for large families and groups in the 'Gateway to the Fells and
        Lakes'. Sleeps 9, or up to 11 with Primrose Cottage. Opening for bookings in 2027 — enquire
        for details.
      </p>
      <div class="hero-actions">
        <a href="#enquire" class="btn btn-white">Check Availability</a>
        <a href="#about" class="btn btn-outline">Explore</a>
      </div>
      <div class="hero-stats">
        <div><div class="h-stat-num">5</div><div class="h-stat-label">Bedrooms</div></div>
        <div><div class="h-stat-num">9</div><div class="h-stat-label">Guests</div></div>
        <div><div class="h-stat-num">3</div><div class="h-stat-label">Car Parking</div></div>
      </div>
    </div>
    <div class="hero-right">
      <img src="/images/rockery-view.jpg" alt="Fell views and drystone walls near The Rockery, Shap" />
      <div class="hero-overlay-card">
        <div class="hoc-label">Home-from-home</div>
        <div class="hoc-val">The Rockery</div>
        <div class="hoc-sub">Shap Village, Lake District · Private entrance &amp; key</div>
      </div>
    </div>
  </section>

  <!-- COMING SOON 2027 -->
  <aside class="coming-soon">
    <div class="coming-soon-inner">
      <span class="coming-soon-tag">Coming Soon · 2027</span>
      <p>
        The Rockery is being lovingly prepared and will welcome its first guests in 2027. Enquire via
        the form below for more details and to register your interest.
      </p>
      <a href="#enquire" class="btn btn-white">Enquire for Details</a>
    </div>
  </aside>

  <!-- BADGES -->
  <div class="badges">
    <div class="badge-item"><span class="badge-dot"></span>Walks from the Door</div>
    <div class="badge-item"><span class="badge-dot"></span>Bed Linen &amp; Towels</div>
    <div class="badge-item"><span class="badge-dot"></span>Logs for Wood Burner</div>
    <div class="badge-item"><span class="badge-dot"></span>Welcome Pack</div>
    <div class="badge-item"><span class="badge-dot"></span>Wi-Fi Included</div>
    <div class="badge-item"><span class="badge-dot"></span>BBQ &amp; Garden Furniture</div>
    <div class="badge-item"><span class="badge-dot"></span>Dogs Welcome</div>
    <div class="badge-item"><span class="badge-dot"></span>Parking for 3 Cars</div>
    <div class="badge-item"><span class="badge-dot"></span>Customers' Choice 2021–2025*</div>
  </div>

  <!-- ABOUT -->
  <section class="section about" id="about">
    <div class="about-inner">
      <div class="reveal">
        <p class="eyebrow">The Property</p>
        <h2 class="section-h">Where History<br />Meets <em>Modern Comfort</em></h2>
        <div class="about-text">
          <p>
            The Rockery is a handsome Grade II Listed house in the village of Shap, thoughtfully
            designed to blend period character — high ceilings, original features, tiled
            fireplaces — with the comfort a modern family holiday demands.
          </p>
          <p>
            With five bedrooms, generous living and dining rooms, a well-equipped kitchen and a charming
            log burner, there's room for everyone to gather and space for everyone to retreat.
          </p>
        </div>
        <div class="about-highlight">
          <p>Sleeps 9 in the house — or book alongside Primrose Cottage for groups of up to 11.</p>
        </div>
        <a href="#enquire" class="btn btn-green" style="margin-top:2rem;">Enquire to Book</a>
      </div>
      <div class="about-images reveal" style="transition-delay:0.15s;">
        <div class="ai-card span2" style="height:220px;">
          <img src="/images/master-view.jpg" alt="View from the master bedroom" loading="lazy" />
        </div>
        <div class="ai-card" style="height:180px;">
          <img src="/images/kitchen.jpg" alt="The Rockery kitchen" loading="lazy" />
        </div>
        <div class="ai-card" style="height:180px;">
          <img src="/images/feature-bedroom.jpg" alt="Feature bedroom with fireplace" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section features">
    <div class="features-header reveal">
      <div>
        <p class="eyebrow">Key Features</p>
        <h2 class="section-h">Everything<br /><em>Included</em></h2>
      </div>
      <a href="#enquire" class="btn btn-white" style="color:var(--coniston-blue);align-self:flex-end;">Book Your Stay</a>
    </div>
    <div class="feat-grid">
      <div class="feat-card reveal">
        <div class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="5.5" cy="10.5" r="1.6"/><circle cx="9.5" cy="6.5" r="1.6"/><circle cx="14.5" cy="6.5" r="1.6"/><circle cx="18.5" cy="10.5" r="1.6"/><path d="M8 16c0-2.2 1.8-4 4-4s4 1.8 4 4c0 1.7-1.3 2.8-4 2.8S8 17.7 8 16z"/></svg></div>
        <h3>Dogs Welcome</h3>
        <p>Up to two well-behaved dogs are welcome — bring the whole family.</p>
      </div>
      <div class="feat-card reveal" style="transition-delay:.07s;">
        <div class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 20l6-8 4 5 3-4 5 7z" stroke-linejoin="round"/></svg></div>
        <h3>Fell Views &amp; Walks</h3>
        <p>Views over the open Eastern Fells, with walks, runs and rides straight from the door.</p>
      </div>
      <div class="feat-card reveal" style="transition-delay:.14s;">
        <div class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 8l8-4 8 4-8 4z"/><path d="M4 8v8l8 4 8-4V8"/></svg></div>
        <h3>Welcome Pack Included</h3>
        <p>A thoughtful welcome pack to greet you on arrival.</p>
      </div>
      <div class="feat-card reveal" style="transition-delay:.21s;">
        <div class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3s5 4 5 9a5 5 0 01-10 0c0-2 1-3 1-3"/></svg></div>
        <h3>Log Burner + Wi-Fi</h3>
        <p>Cosy wood-burner warmth and reliable broadband throughout.</p>
      </div>
      <div class="feat-card reveal" style="transition-delay:.28s;">
        <div class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="8" width="18" height="12" rx="1"/><path d="M8 8V5h8v3"/></svg></div>
        <h3>Enclosed Garden &amp; BBQ</h3>
        <p>Private garden with furniture and a BBQ for summer evenings.</p>
      </div>
      <div class="feat-card reveal" style="transition-delay:.35s;">
        <div class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="8" r="3"/><path d="M15 21v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2"/><path d="M16 11l2 2 4-4"/></svg></div>
        <h3>Sleeps up to 11</h3>
        <p>Nine in the house, eleven with Primrose Cottage next door.</p>
      </div>
      <div class="feat-card reveal" style="transition-delay:.42s;">
        <div class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l2.5 5 5.5.8-4 3.9.9 5.4L12 15.5 7.1 18l.9-5.4-4-3.9 5.5-.8z" stroke-linejoin="round"/></svg></div>
        <h3>Award-Winning Stay</h3>
        <p>Customers' Choice winners 2021–2025.</p>
      </div>
      <div class="feat-card reveal" style="transition-delay:.49s;">
        <div class="feat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="11" width="18" height="8" rx="1"/><path d="M6 11V8a6 6 0 0112 0v3"/></svg></div>
        <h3>Parking &amp; Bike Store</h3>
        <p>Parking for three cars plus secure bike storage.</p>
      </div>
    </div>
  </section>

  <!-- ROOMS -->
  <section class="section rooms" id="rooms">
    <div class="rooms-intro">
      <div class="reveal">
        <p class="eyebrow">Accommodation</p>
        <h2 class="section-h">Generous Rooms,<br /><em>Real Character</em></h2>
      </div>
      <div class="reveal" style="transition-delay:.1s;">
        <p>
          Five versatile bedrooms across two floors, two elegant reception rooms and a well-equipped
          kitchen — The Rockery is built for gatherings, with quiet corners for when you need them.
        </p>
      </div>
    </div>
    <div class="rooms-grid reveal">
      <div class="room-card">
        <div class="room-num">Bedroom 01</div>
        <div class="room-name">Master Bedroom</div>
        <p class="room-desc">Spacious principal bedroom with high ceilings, original features, and a large front-aspect window. Carpet flooring.</p>
      </div>
      <div class="room-card">
        <div class="room-num">Bedroom 02 · En-suite</div>
        <div class="room-name">Double + En-suite</div>
        <p class="room-desc">Rear-facing sash window with Fell views. Three-piece en-suite with corner shower, WC and basin.</p>
      </div>
      <div class="room-card">
        <div class="room-num">Bedroom 03</div>
        <div class="room-name">Double Bedroom</div>
        <p class="room-desc">Comfortable double with fitted wardrobes and front-aspect double-glazed window. Carpet flooring.</p>
      </div>
      <div class="room-card">
        <div class="room-num">Bedroom 04 · Jack &amp; Jill</div>
        <div class="room-name">Double with Feature Fireplace</div>
        <p class="room-desc">Fitted wardrobes, tiled feature fireplace, high ceilings. Shares double-shower Jack &amp; Jill en-suite with Bedroom 5.</p>
      </div>
      <div class="room-card">
        <div class="room-num">Bedroom 05</div>
        <div class="room-name">Single / Jack &amp; Jill</div>
        <p class="room-desc">Large single with rear sash window, sharing access to the double-shower Jack &amp; Jill bathroom with Bedroom 4.</p>
      </div>
      <div class="room-card">
        <div class="room-num">Ground Floor</div>
        <div class="room-name">Modern Kitchen</div>
        <p class="room-desc">A well-equipped modern kitchen for breakfasts and lunches — and perfect for Christmas feasts.</p>
      </div>
      <div class="room-card">
        <div class="room-num">Ground Floor</div>
        <div class="room-name">Principal Living Room</div>
        <p class="room-desc">The heart of the home — expansive, light-filled, with a charming log burner and front-aspect window.</p>
      </div>
      <div class="room-card">
        <div class="room-num">Ground Floor</div>
        <div class="room-name">Dining Room</div>
        <p class="room-desc">High ceilings, original features, electric fire, and sash window. Flows naturally into the kitchen and side porch.</p>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="section gallery" id="gallery">
    <div class="gallery-header reveal">
      <div>
        <p class="eyebrow">Gallery</p>
        <h2 class="section-h">See the <em>Space</em></h2>
      </div>
    </div>
    <div class="gallery-grid reveal" style="transition-delay:.1s;">
      <div class="g-card tall"><img src="/images/rockery-front.jpg" alt="The Rockery — front" loading="lazy" /><div class="g-card-label">The Rockery — Front</div></div>
      <div class="g-card"><img src="/images/kitchen.jpg" alt="Kitchen" loading="lazy" /><div class="g-card-label">Kitchen</div></div>
      <div class="g-card"><img src="/images/feature-bedroom.jpg" alt="Feature bedroom" loading="lazy" /><div class="g-card-label">Feature Bedroom</div></div>
      <div class="g-card"><img src="/images/double-bedroom.jpg" alt="Double bedroom" loading="lazy" /><div class="g-card-label">Double Bedroom</div></div>
      <div class="g-card"><img src="/images/family-bathroom.jpg" alt="Family bathroom" loading="lazy" /><div class="g-card-label">Family Bathroom</div></div>
    </div>
    <div class="gallery-grid reveal" style="transition-delay:.2s;margin-top:0.8rem;">
      <div class="g-card"><img src="/images/garden.jpg" alt="Garden" loading="lazy" /><div class="g-card-label">Garden</div></div>
      <div class="g-card"><img src="/images/master-view.jpg" alt="View from master bedroom" loading="lazy" /><div class="g-card-label">View from Master Bedroom</div></div>
      <div class="g-card tall"><img src="/images/fell-views.jpg" alt="Fell views" loading="lazy" /><div class="g-card-label">Fell Views</div></div>
      <div class="g-card"><img src="/images/ensuite-bedroom.jpg" alt="En-suite bedroom" loading="lazy" /><div class="g-card-label">En-suite Bedroom</div></div>
      <div class="g-card"><img src="/images/rockery-rear.jpg" alt="The Rockery — fountain courtyard" loading="lazy" /><div class="g-card-label">The Rockery — Courtyard</div></div>
    </div>
  </section>

  <!-- SISTER PROPERTY -->
  <section class="annexe" id="cottage">
    <div class="annexe-img reveal">
      <img src="/images/primrose-main.jpg" alt="Primrose Cottage" loading="lazy" />
      <div class="annexe-img-badge">Primrose Cottage</div>
    </div>
    <div class="annexe-content reveal" style="transition-delay:.15s;">
      <p class="eyebrow">Book Together</p>
      <h2 class="section-h">Add<br /><em>Primrose Cottage</em></h2>
      <p>
        Travelling as a larger group? Add our neighbouring cottage and sleep up to 11 across one
        address — perfect for extended families who want their own space but time together.
      </p>
      <div class="annexe-list">
        <div class="al-item"><span class="al-dot"></span>Self-contained one-bedroom cottage, sleeps 2 + child under 2</div>
        <div class="al-item"><span class="al-dot"></span>King-size bed, private entrance &amp; welcome pack</div>
        <div class="al-item"><span class="al-dot"></span>Own seating area &amp; BBQ · ideal Coast to Coast stopover</div>
      </div>
      <a href="/primrose-cottage/" class="btn btn-green" style="margin-top:1.8rem;">View Primrose Cottage</a>
    </div>
  </section>

  <!-- LOCATION -->
  <section class="section location" id="location">
    <div class="location-inner">
      <div class="reveal">
        <p class="eyebrow">Where to Find Us</p>
        <h2 class="section-h">Shap Village,<br /><em>Cumbria</em></h2>
        <p>
          On the eastern edge of the Lake District National Park, with the pub, shop and restaurant a
          short stroll away, and the high fells, Haweswater and Ullswater within easy reach.
        </p>
        <div class="loc-stats">
          <div class="loc-stat"><div class="ls-num">200 yds</div><div class="ls-label">Pub, Shop &amp; Restaurant</div></div>
          <div class="loc-stat"><div class="ls-num">8 mi</div><div class="ls-label">Haweswater &amp; Red Squirrels</div></div>
          <div class="loc-stat"><div class="ls-num">&lt; 20 min</div><div class="ls-label">Penrith &amp; Ullswater</div></div>
          <div class="loc-stat"><div class="ls-num">1 hr</div><div class="ls-label">Scotland &amp; Northumberland</div></div>
        </div>
      </div>
      <div class="loc-map reveal" style="transition-delay:.15s;">
        <div class="loc-map-bg"></div>
        <div class="loc-pin"></div>
        <p>Shap, Cumbria</p>
        <small>CA10 · M6 Junction 39</small>
      </div>
    </div>
  </section>

  <!-- AVAILABILITY -->
  <AvailabilityCalendar property="the-rockery" months={4} theme="blue" />

  <!-- ENQUIRE -->
  <section class="section enquire" id="enquire">
    <div class="enquire-inner">
      <div class="reveal">
        <p class="eyebrow">Book Your Stay</p>
        <h2 class="section-h">Ready for Your<br /><em>Lake District</em><br />Escape?</h2>
        <p class="enquire-desc">
          Send us your dates and we'll come back to you with full availability and pricing. The Rockery
          sleeps up to 9, or book together with Primrose Cottage for groups of up to 11.
        </p>
        <p class="enquire-desc" style="margin-top:1rem;">
          Or reach us directly at<br /><strong style="color:#fff;">hello@lakedistrictescapes.uk</strong>
        </p>
      </div>
      <div class="enquire-form-wrap reveal" style="transition-delay:.15s;">
        <form name="enquiry-rockery" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/">
          <input type="hidden" name="form-name" value="enquiry-rockery" />
          <input type="hidden" name="property" value="The Rockery" />
          <p class="hp-field"><label>Don't fill this in: <input name="bot-field" /></label></p>
          <div class="form-row">
            <div class="form-field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" placeholder="Your name" required />
            </div>
            <div class="form-field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" placeholder="you@example.com" required />
            </div>
          </div>
          <div class="form-field">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="Optional — for a quick call back" />
          </div>
          <div class="form-row">
            <div class="form-field">
              <label for="arrive">Arrival</label>
              <input id="arrive" name="arrive" type="date" />
            </div>
            <div class="form-field">
              <label for="depart">Departure</label>
              <input id="depart" name="depart" type="date" />
            </div>
          </div>
          <div class="form-field">
            <label for="guests">Number of Guests</label>
            <input id="guests" name="guests" type="number" min="1" max="12" placeholder="e.g. 8" />
          </div>
          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell us a little about your trip…"></textarea>
          </div>
          <button class="form-submit" type="submit">Send Enquiry</button>
          <p class="form-note">We aim to respond within 4 hours during business hours.</p>
        </form>
      </div>
    </div>
  </section>

  <p class="page-footnote">
    * Customers' Choice awards (2021–2025) received via cottages.com.
  </p>

  <Footer slot="footer" />
</Base>
